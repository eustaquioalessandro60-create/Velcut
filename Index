<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <title>Grupo Rimane · Ecossistema Digital</title>
    <style>
        :root {
            --amarelo: #FFB800;
            --laranja: #F97316;
            --verde-folha: #2D6A4F;
            --marrom-terra: #7F4F24;
            --vermelho-vivo: #D62828;
            --preto: #1E1E1E;
            --branco: #FFFFFF;
            --cinza-suave: #F5F5F5;
            --sombra: 0 8px 30px rgba(0,0,0,0.08);
            --borda: 20px;
            --transicao: all 0.25s ease;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background: #fafaf7;
            color: var(--preto);
            min-height: 100vh;
            padding: 1rem;
        }

        .container-geral {
            max-width: 1350px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        /* ========== PÁGINAS INTERNAS ========== */
        .pagina {
            display: none;
            animation: fadeIn 0.3s ease;
        }
        .pagina.ativa { display: block; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* ========== HEADER ========== */
        .header {
            background: var(--branco);
            border-radius: var(--borda);
            padding: 1.2rem 2rem;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            box-shadow: var(--sombra);
            gap: 1rem;
        }

        .logo { display: flex; align-items: center; gap: 0.7rem; }
        .logo-icone {
            background: linear-gradient(135deg, var(--amarelo), var(--laranja));
            width: 50px; height: 50px;
            border-radius: 16px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.8rem; font-weight: 800; color: white;
        }
        .logo-texto h2 { font-size: 1.6rem; }
        .logo-texto span { color: var(--laranja); }

        .dominio-badge {
            background: var(--preto); color: var(--amarelo);
            padding: 0.5rem 1.2rem; border-radius: 50px;
            font-weight: 700; font-size: 0.9rem;
        }

        /* ========== BOTÃO DOWNLOAD ZIP ========== */
        .zip-banner {
            background: linear-gradient(105deg, #1a1a1a, #2d2d2d);
            border-radius: var(--borda);
            padding: 1.8rem;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: center;
            gap: 1.5rem;
            cursor: pointer;
            transition: var(--transicao);
            border: 2px solid transparent;
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
        }
        .zip-banner:hover {
            border-color: var(--amarelo);
            transform: scale(1.01);
        }
        .zip-banner .icone { font-size: 3.5rem; }
        .zip-banner h3 { color: white; font-size: 1.6rem; }
        .zip-banner p { color: #aaa; }

        .btn-download {
            background: var(--amarelo);
            color: var(--preto);
            padding: 1rem 2rem;
            border-radius: 50px;
            font-weight: 800;
            border: none;
            cursor: pointer;
            transition: var(--transicao);
            font-size: 1rem;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }
        .btn-download:hover {
            background: var(--laranja);
            color: white;
            transform: scale(1.05);
        }

        /* ========== NAVEGAÇÃO ========== */
        .nav-bar {
            display: flex;
            flex-wrap: wrap;
            gap: 0.6rem;
            justify-content: center;
        }
        .nav-btn {
            background: white;
            border: 2px solid #e0dcd0;
            padding: 0.7rem 1.3rem;
            border-radius: 50px;
            font-weight: 700;
            cursor: pointer;
            transition: var(--transicao);
            font-size: 0.9rem;
            text-decoration: none;
            color: var(--preto);
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }
        .nav-btn:hover, .nav-btn.ativo {
            background: var(--amarelo);
            border-color: var(--amarelo);
        }

        /* ========== GRADE CARDS ========== */
        .grade {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 1rem;
        }
        .card {
            background: white;
            border-radius: var(--borda);
            padding: 1.5rem 1rem;
            text-align: center;
            cursor: pointer;
            transition: var(--transicao);
            border: 2px solid transparent;
            text-decoration: none;
            color: var(--preto);
        }
        .card:hover {
            border-color: var(--laranja);
            transform: translateY(-4px);
            box-shadow: 0 12px 25px rgba(249,115,22,0.12);
        }
        .card-icone { font-size: 2.5rem; margin-bottom: 0.5rem; }
        .card h4 { font-size: 1.1rem; margin-bottom: 0.3rem; }
        .card small { color: var(--marrom-terra); }

        /* ========== PÁGINAS INTERNAS ESTILO ========== */
        .pagina-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }
        .btn-voltar {
            background: var(--cinza-suave);
            border: none;
            padding: 0.6rem 1.2rem;
            border-radius: 30px;
            cursor: pointer;
            font-weight: 700;
            transition: var(--transicao);
            text-decoration: none;
            color: var(--preto);
        }
        .btn-voltar:hover { background: #ddd; }

        .painel-info {
            background: white;
            border-radius: var(--borda);
            padding: 2rem;
            box-shadow: var(--sombra);
            margin-top: 1rem;
        }

        .grid-config {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.2rem;
        }

        .acao-btn {
            background: var(--amarelo);
            border: none;
            padding: 0.8rem 1.5rem;
            border-radius: 50px;
            font-weight: 700;
            cursor: pointer;
            transition: var(--transicao);
            font-size: 0.9rem;
            text-decoration: none;
            color: var(--preto);
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
        }
        .acao-btn:hover {
            background: var(--laranja);
            color: white;
        }
        .acao-btn.verde { background: var(--verde-folha); color: white; }
        .acao-btn.vermelho { background: var(--vermelho-vivo); color: white; }

        .aviso {
            background: #e8f5e9;
            border-left: 5px solid var(--verde-folha);
            padding: 1rem 1.5rem;
            border-radius: 12px;
            margin: 1rem 0;
            font-weight: 500;
        }

        .notificacao {
            position: fixed;
            bottom: 25px;
            right: 25px;
            background: var(--preto);
            color: white;
            padding: 1rem 2rem;
            border-radius: 50px;
            z-index: 9999;
            font-weight: 600;
            animation: slideUp 0.3s ease;
        }
        @keyframes slideUp {
            from { transform: translateY(20px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        @media (max-width: 600px) {
            .grade { grid-template-columns: repeat(2, 1fr); }
            .zip-banner { flex-direction: column; text-align: center; }
        }
    </style>
